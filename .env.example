# Copy to .env to override defaults. The app runs fine with no .env at all.
# SECRET_KEY=generate-a-real-one-for-anything-beyond-a-laptop
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# TIME_ZONE=America/Chicago
# MEDIA_ROOT=/absolute/path/to/media

# Email. Without these, emails print to the runserver terminal.
# To send real mail over SMTP, uncomment and fill in (keep real values in .env only):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-username
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=ThoughtTronix <no-reply@example.com>
